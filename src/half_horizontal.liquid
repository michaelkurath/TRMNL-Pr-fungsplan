<div class="layout layout--col gap--small"><div class="title_bar"><span class="title">Prüfungsplan</span><span class="instance">{{ updated }}</span></div>{% if exams.size > 0 %}<div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;">{% for exam in exams limit:6 %}<div style="border-bottom:1px solid #888;padding:5px;"><div class="label">{{ exam.date_label }} · {{ exam.days }} T</div><div class="label" style="font-weight:bold;">{{ exam.subject | escape }}</div><div class="value">{{ exam.topic | escape }}</div></div>{% endfor %}</div>{% else %}<div class="value">Keine bevorstehenden Prüfungen</div>{% endif %}</div>