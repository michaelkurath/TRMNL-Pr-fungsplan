<div class="layout layout--col gap--small">
  <div class="title_bar"><span class="title">PRÜFUNGSPLAN</span><span class="instance">{{ updated }}</span></div>
  <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;">
  {% if subjects.size == 0 %}<div class="item"><div class="value">Keine bevorstehenden Prüfungen</div></div>{% endif %}
  {% for subject in subjects limit:4 %}
   <div class="item" style="border:1px solid #888;padding:8px;min-width:0;">
    <div class="label" style="font-weight:bold;border-bottom:1px solid #999;">{{ subject.name | upcase | escape }}</div>
    {% for exam in subject.exams limit:2 %}
     <div style="padding-top:5px;">
      <div class="label">{{ exam.date_label }} · {% if exam.days == 0 %}HEUTE{% elsif exam.days == 1 %}MORGEN{% else %}in {{ exam.days }} Tagen{% endif %}</div>
      <div class="value" style="font-size:16px;overflow-wrap:anywhere;">{{ exam.topic | escape }}</div>
      {% if exam.note != blank %}<div class="description">{{ exam.note | escape }}</div>{% endif %}
     </div>
    {% endfor %}
   </div>
  {% endfor %}
  </div>
</div>