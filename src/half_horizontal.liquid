<style>
  .exam-qr .qr-code { display:block; width:100%; height:auto; }
</style>
<div class="layout layout--col gap--small">
  <div style="display:flex;align-items:flex-start;gap:8px;width:100%;min-width:0;">
    <div class="exam-list" style="flex:1;min-width:0;">
      {% if exams != blank and exams.size > 0 %}
        {% for exam in exams limit:3 %}
          <div style="display:grid;grid-template-columns:76px minmax(0,1fr) 51px;gap:8px;align-items:start;padding:6px 0;border-bottom:1px solid #999;min-width:0;">
            <div style="font-size:20px;line-height:1.12;font-weight:800;white-space:nowrap;">{{ exam.date_label | escape }}</div>
            <div style="min-width:0;">
              <div style="font-size:19px;line-height:1.12;font-weight:800;text-transform:uppercase;overflow-wrap:anywhere;">{{ exam.subject | escape }}</div>
              <div style="font-size:15px;line-height:1.18;overflow-wrap:anywhere;">{{ exam.topic | escape }}</div>
              
            </div>
            <div class="label" style="text-align:right;font-weight:700;">{% if exam.days == 0 %}HEUTE{% elsif exam.days == 1 %}MORGEN{% else %}{{ exam.days }} T{% endif %}</div>
          </div>
        {% endfor %}
      {% else %}
        <div class="value">Keine bevorstehenden Prüfungen</div>
      {% endif %}
    </div>
    {% if form_url != blank %}
      <div class="exam-qr" style="flex:0 0 144px;width:144px;text-align:center;">
        <div style="background:white;border:1px solid #333;padding:4px;">{{ form_url | qr_code }}</div>
        <div class="label" style="font-weight:700;margin-top:5px;">{% if entry_mode == 'sheet' %}TABELLE ÖFFNEN{% else %}NEUE PRÜFUNG{% endif %}</div>
        <div class="description">QR scannen</div>
      </div>
    {% endif %}
  </div>
</div>
<div class="title_bar">
  <span class="title">Prüfungsplan</span>
  <span class="instance">{{ updated }}</span>
</div>
