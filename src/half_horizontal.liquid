<div class="layout layout--col gap--medium">
  <div class="title_bar">
    <span class="title">Prüfungsplan</span>
    <span class="instance">{% if updated != blank %}{{ updated }}{% else %}Google Sheets{% endif %}</span>
  </div>
  {% if subjects != blank and subjects.size > 0 %}
    <div style="display:grid;grid-template-columns:repeat(2, minmax(0,1fr));gap:12px;width:100%;align-content:start;">
      {% for subject in subjects limit:4 %}
        <div style="border-top:3px solid black;padding:7px 3px;min-width:0;">
          <div class="label label--large" style="font-weight:700;">{{ subject.name | upcase | escape }}</div>
          {% for exam in subject.exams limit:2 %}
            <div style="padding:8px 0 5px;border-bottom:1px solid #aaa;">
              <div style="display:flex;justify-content:space-between;gap:6px;">
                <span class="label">{{ exam.date_label | escape }}</span>
                <span class="label">{% if exam.days == 0 %}HEUTE{% elsif exam.days == 1 %}MORGEN{% else %}{{ exam.days }} TAGE{% endif %}</span>
              </div>
              <div style="font-size:16px;line-height:1.2;font-weight:650;overflow-wrap:anywhere;">{{ exam.topic | escape }}</div>
              {% if exam.note != blank %}<div class="description">{{ exam.note | escape }}</div>{% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div style="width:100%;padding:28px 12px;text-align:center;">
      <div class="value value--medium">Noch keine Prüfungstermine</div>
      <div class="description">Google Sheets verbinden und synchronisieren</div>
    </div>
  {% endif %}
</div>
